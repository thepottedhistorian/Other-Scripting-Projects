function setWebAppDashboardUrl() {
  const ui = SpreadsheetApp.getUi();
  const props = PropertiesService.getScriptProperties();
  const current = props.getProperty("WEB_APP_URL") || "";

  const resp = ui.prompt(
    "Set Web App Dashboard URL",
    "Paste your deployed Web App URL (must end in /exec):\n\nCurrent: " + (current || "Default"),
    ui.ButtonSet.OK_CANCEL
  );

  if (resp.getSelectedButton() !== ui.Button.OK) return;
  const newUrl = resp.getResponseText().trim();

  if (!newUrl.startsWith("https://script.google.com/") || !newUrl.endsWith("/exec")) {
    ui.alert("Invalid URL", "Please paste the full Web app URL from Deploy > Manage deployments (it must end with /exec).", ui.ButtonSet.OK);
    return;
  }

  props.setProperty("WEB_APP_URL", newUrl);
  ui.alert("Saved! Clicking '🌐 Open Web App Dashboard' will now open your Web App URL.");
}
