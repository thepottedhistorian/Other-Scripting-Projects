function openWebAppDashboard() {
  const url = ScriptApp.getService().getUrl();
  if (!url) {
    SpreadsheetApp.getUi().alert(
      "Web App Not Deployed Yet",
      "To activate the Web App Dashboard:\n\n" +
      "1. Click Extensions > Apps Script.\n" +
      "2. Click Deploy (top right) > New deployment.\n" +
      "3. Click the gear icon next to 'Select type' and choose 'Web app'.\n" +
      "4. Set 'Execute as: Me' and 'Who has access: Only myself', then click Deploy.",
      SpreadsheetApp.getUi().ButtonSet.OK
    );
    return;
  }

  const html = HtmlService.createHtmlOutput(
    `<html><body style="font-family: sans-serif; padding: 14px;">
      <p>Opening <strong>Jenny's Potted Ledger</strong> Web App...</p>
      <p><a href="${url}" target="_blank" onclick="google.script.host.close()">Click here if it does not open automatically ↗</a></p>
      <script>
        var win = window.open("${url}", "_blank");
        if (win) { google.script.host.close(); }
      </script>
    </body></html>`
  ).setWidth(360).setHeight(130);

  SpreadsheetApp.getUi().showModalDialog(html, "Launching Web App Dashboard");
}

