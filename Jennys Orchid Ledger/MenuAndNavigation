/**
 * Custom Spreadsheet Formulas for Collection Overview
 */
function COUNT_MAIN_ORCHIDS() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const inv = ss.getSheetByName(INVENTORY_SHEET);
  if (!inv || inv.getLastRow() < 2) return 0;

  const names = inv.getRange(2, NAME_COL + 1, inv.getLastRow() - 1, 1).getValues();
  let count = 0;
  for (let i = 0; i < names.length; i++) {
    if (String(names[i][0]).trim() !== "") count++;
  }
  return count;
}

function COUNT_MAIN_BLOOMS() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const inv = ss.getSheetByName(INVENTORY_SHEET);
  if (!inv || inv.getLastRow() < 2) return 0;

  const statuses = inv.getRange(2, BLOOM_STATUS_COL + 1, inv.getLastRow() - 1, 1).getValues();
  let bloomCount = 0;
  statuses.forEach(row => {
    const s = String(row[0]).toLowerCase().trim();
    if (s.includes("in bloom") && !s.includes("not in bloom")) bloomCount++;
  });
  return bloomCount;
}

function GET_MAIN_LATEST_WATERING() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();
  let latestDate = new Date(0);

  sheets.forEach(sheet => {
    if (/^\d+(-\d+)?$/.test(sheet.getName().trim()) && sheet.getLastRow() >= 20) {
      const colL = sheet.getRange(20, 12, sheet.getLastRow() - 19, 1).getValues();
      for (let r = 0; r < colL.length; r++) {
        if (colL[r][0]) {
          const d = colL[r][0] instanceof Date ? colL[r][0] : new Date(colL[r][0]);
          if (!isNaN(d.getTime()) && d > latestDate) latestDate = d;
        }
      }
    }
  });

  return latestDate.getTime() === 0 ? "No Dates Found" : latestDate;
}

